# Copy to scripts/remote.env and fill in. That file is gitignored -- host details
# and usernames stay out of the public repo.
#
# Set up key auth first so nothing here needs a password. If you have several
# keys, disable pubkey auth for the copy or ssh trips the server's MaxAuthTries:
#   ssh-copy-id -o PubkeyAuthentication=no -o PreferredAuthentications=password \
#     -i ~/.ssh/id_ed25519.pub -p PORT USER@HOST

REMOTE_USER=your.username
REMOTE_HOST=10.0.0.0
REMOTE_PORT=22
REMOTE_DIR=~/nanoserve

# Pin one key. Without this, ssh offers every key in ~/.ssh and a server with a
# low MaxAuthTries rejects the connection before reaching the right one.
REMOTE_SSH_KEY=~/.ssh/id_ed25519

# Shell run on the remote before python, for clusters that gate toolchains behind
# environment modules. Leave empty on a plain box.
#
# Quote it. This file is sourced by the shell, so an unquoted `&&` would run the
# first half locally instead of shipping the whole string to the remote.
#   e.g. REMOTE_INIT="source /etc/profile.d/modules.sh && module load anaconda3"
REMOTE_INIT=""

# Interpreter used to *create* the venv. After `setup`, everything runs from
# $REMOTE_DIR/.venv/bin/python regardless.
REMOTE_PYTHON=python3

# Which GPU(s) to expose. On a shared box, pin one card so you don't contend
# with other users' jobs. Empty means all visible devices.
CUDA_DEVICES=0
